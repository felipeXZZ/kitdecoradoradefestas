# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só em rota de servidor (fases 5 e 6). Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app, sem barra no final. Ex: https://kitdadecoradora.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só dígitos, com DDI e DDD. Ex: 5511999998888
NEXT_PUBLIC_WHATSAPP_NUMERO=

# Link do checkout do upgrade de R$ 12
NEXT_PUBLIC_CHECKOUT_UPGRADE_URL=

# Deixe vazio para esconder o banner
NEXT_PUBLIC_BANNER_NOVIDADE=
NEXT_PUBLIC_BANNER_NOVIDADE_URL=

# Assina o cookie de acesso. Qualquer texto longo e aleatório serve.
SESSAO_SECRET=

# Fase 5 — webhook de compra (GGCheckout)
# Mesmo segredo cadastrado na GGCheckout; chega em x-secret ou Authorization: Bearer.
WEBHOOK_SECRET=
# IDs dos produtos na GGCheckout, separados por vírgula se houver mais de um
# (ex: a oferta de R$ 22,90 do pop-up entra junto com o completo).
WEBHOOK_PRODUTOS_BASICO=
WEBHOOK_PRODUTOS_COMPLETO=
WEBHOOK_PRODUTOS_UPGRADE=

# Fase 6 — e-mails com acesso ao /admin, separados por vírgula
ADMIN_EMAILS=
